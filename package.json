{
  "name": "@bizrnr/blog-engine",
  "version": "0.9.0",
  "description": "Canonical BizRnR autonomous blog engine for database- or file-backed publishing and rendering.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "examples",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:docs",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.62",
    "ai": "^7.0.77",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  }
}
